# Server: připojení k Neonu (ve Vercelu přes Neon integraci). Povinné v produkci.
DATABASE_URL=

# Klient: ID webu a adresa skriptu z tracking kódu v Umami Cloud (Settings → Tracking code). Povinné v produkci.
# Analytika se zapne jen s oběma hodnotami a s NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Klient: veřejná URL webu (canonical, Open Graph). Povinné v produkci.
NEXT_PUBLIC_SITE_URL=

# Server: odesílat tahák i e-mailem (jen s ověřenou doménou v Resendu). Výchozí false.
EMAIL_ENABLED=false

# Server: jen když EMAIL_ENABLED=true.
RESEND_API_KEY=
EMAIL_FROM=
